# ---------------------------------------------------------------------------
# Variables de entorno del proyecto (plantilla — NO contiene valores reales)
# Copiar a `.env` y ajustar los valores.
# ---------------------------------------------------------------------------

# Django
DEBUG=True
SECRET_KEY=cambia-esto-por-un-valor-seguro
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (PostgreSQL)
POSTGRES_DB=planmanager_db
POSTGRES_USER=planmanager_user
POSTGRES_PASSWORD=cambia-esta-contrasena
DATABASE_URL=postgres://planmanager_user:cambia-esta-contrasena@localhost:5433/planmanager_db
