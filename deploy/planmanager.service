[Unit]
Description=PlanManager Gunicorn daemon
After=network.target docker.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/planmanager
EnvironmentFile=/opt/planmanager/.env
ExecStart=/opt/planmanager/.venv/bin/gunicorn planmanager.wsgi:application \
    --workers 3 --bind 127.0.0.1:8001 --timeout 120 \
    --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
